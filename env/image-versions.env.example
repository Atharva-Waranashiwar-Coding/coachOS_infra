# Pin every image to an immutable registry digest before production deployment.
AUTH_IMAGE=ghcr.io/your-org/coachos-auth-service@sha256:replace
ATHLETE_IMAGE=ghcr.io/your-org/coachos-athlete-service@sha256:replace
MEDIA_IMAGE=ghcr.io/your-org/coachos-media-service@sha256:replace
AI_REVIEW_IMAGE=ghcr.io/your-org/coachos-ai-review-service@sha256:replace
ASSISTANT_IMAGE=ghcr.io/your-org/coachos-assistant-service@sha256:replace
FRONTEND_IMAGE=ghcr.io/your-org/coachos-frontend@sha256:replace
