[Unit]
Description=CoachOS production stack
After=docker.service
Requires=docker.service
[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/coachos
ExecStart=/usr/bin/docker compose --env-file /etc/coachos/production.env --env-file /etc/coachos/image-versions.env -f compose/docker-compose.prod.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file /etc/coachos/production.env --env-file /etc/coachos/image-versions.env -f compose/docker-compose.prod.yml down
[Install]
WantedBy=multi-user.target
